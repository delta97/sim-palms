{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sim-palms.invalid/schemas/asset-manifest.schema.json",
  "title": "palmfix asset manifest",
  "description": "Generated by `python -m palmcore.assets build-manifest`. Never hand-edit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "package_name",
    "package_version",
    "scale_limits",
    "species_fallback",
    "species"
  ],
  "properties": {
    "manifest_version": {"const": 1},
    "package_name": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "scale_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "number", "exclusiveMinimum": 0},
        "max": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "species_fallback": {
      "type": "object",
      "propertyNames": {"pattern": "^([a-z]+(_[a-z]+)+|_default)$"},
      "additionalProperties": {"$ref": "#/$defs/species_key"}
    },
    "species": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/species_key"},
      "additionalProperties": {"$ref": "#/$defs/species"}
    }
  },
  "$defs": {
    "species_key": {"type": "string", "pattern": "^[a-z]+(_[a-z]+)+$"},
    "species": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common_name", "set", "status", "lean_max_deg", "variants"],
      "properties": {
        "common_name": {"type": "string", "minLength": 1},
        "set": {"enum": ["socal", "florida"]},
        "status": {"enum": ["in_review", "accepted", "draft"]},
        "lean_max_deg": {"type": "number", "minimum": 0, "maximum": 45},
        "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"}}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "height_class",
        "alt",
        "model_name",
        "model_guid",
        "native_height_m",
        "crown_diam_m",
        "model_xml",
        "lods",
        "simobject_title"
      ],
      "properties": {
        "variant": {"type": "string", "pattern": "^(short|medium|tall)(_b)?$"},
        "height_class": {"enum": ["short", "medium", "tall"]},
        "alt": {"enum": [null, "b"]},
        "model_name": {"type": "string", "pattern": "^palmfix_[a-z]+(_[a-z]+)+_(short|medium|tall)(_b)?$"},
        "model_guid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "native_height_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "crown_diam_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "model_xml": {"type": "string", "pattern": "^PackageSources/modelLib/[^/]+/[^/]+/[^/]+\\.xml$"},
        "lods": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/lod"}},
        "simobject_title": {"type": "string", "minLength": 1}
      }
    },
    "lod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lod", "file", "triangles", "min_size", "design_distance_m"],
      "properties": {
        "lod": {"type": "integer", "minimum": 0, "maximum": 3},
        "file": {"type": "string", "pattern": "^[^/\\\\]+_LOD[0-3]\\.gltf$"},
        "triangles": {"type": ["integer", "null"], "minimum": 0},
        "min_size": {"type": ["number", "null"], "minimum": 0},
        "design_distance_m": {"type": "number", "minimum": 0}
      }
    }
  }
}
