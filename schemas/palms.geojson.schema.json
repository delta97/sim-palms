{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palmfix:schema:palms:1",
  "$comment": "Contract between palmscan, palmgen and palmlive. Versioning policy and history: schemas/CHANGELOG.md.",
  "title": "palms.geojson",
  "description": "FeatureCollection of palm trees (schema 1.x). Foreign members at the top level are allowed.",
  "type": "object",
  "required": [
    "type",
    "schema_version",
    "region",
    "generated_at",
    "data_version",
    "generator",
    "config_sha256",
    "features"
  ],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "schema_version": {"type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$(?!\\n)"},
    "region": {"$ref": "#/$defs/slug"},
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$(?!\\n)",
      "description": "UTC timestamp, ends in Z."
    },
    "data_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$(?!\\n)",
      "description": "Data collection key YYYY-MM; palmgen uses it for the +dataYYYY-MM package suffix."
    },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "config_sha256": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$(?!\\n)"},
        {"type": "null"}
      ]
    },
    "bbox": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4
    },
    "features": {
      "type": "array",
      "items": {"$ref": "#/$defs/feature"}
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$(?!\\n)"},
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "id": {"type": "string"},
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"const": "Point"},
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {"type": "number", "minimum": -180, "maximum": 180},
                {"type": "number", "minimum": -90, "maximum": 90}
              ],
              "description": "[lon, lat], WGS84."
            }
          },
          "additionalProperties": false
        },
        "properties": {
          "type": "object",
          "required": [
            "palm_id",
            "species",
            "species_confidence",
            "species_source",
            "height_m",
            "height_source",
            "crown_diam_m",
            "ground_elev_m",
            "detected_by",
            "source_ids",
            "exclusion_radius_m",
            "building_conflict",
            "data_vintage",
            "region"
          ],
          "properties": {
            "palm_id": {"type": "string", "pattern": "^[a-z]{2,6}-[0-9a-f]{16}$(?!\\n)"},
            "species": {
              "type": "string",
              "pattern": "^[a-z]+(_[a-z]+)+$(?!\\n)",
              "description": "Species key. A pattern, not an enum; the canonical list is palmscan/data/species_keys.yaml."
            },
            "species_confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "species_source": {
              "enum": ["inventory", "osm", "prior", "lidar_rules", "lidar_tree"]
            },
            "height_m": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 60,
              "description": "Metres above ground."
            },
            "height_source": {
              "enum": ["inventory", "species_default", "lidar", "region_median"]
            },
            "crown_diam_m": {"type": "number", "minimum": 0.3, "maximum": 20},
            "ground_elev_m": {
              "type": ["number", "null"],
              "minimum": -100,
              "maximum": 4000,
              "description": "Metres, orthometric height of the ground at the palm point. VERIFY: against the 3DEP vertical datum (usually NAVD88; SCAN-021 and SCAN-101 confirm). Null in Phase 1. Informational only; palmgen snaps to sim ground."
            },
            "detected_by": {
              "enum": [
                "inventory",
                "osm",
                "lidar",
                "inventory+osm",
                "inventory+lidar",
                "osm+lidar",
                "inventory+osm+lidar"
              ]
            },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z0-9_]+:.+$(?!\\n)"},
              "description": "<source name>:<record id>, sorted."
            },
            "exclusion_radius_m": {"type": "number", "minimum": 0.3, "maximum": 15},
            "building_conflict": {"type": "boolean"},
            "data_vintage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "inventory": {"$ref": "#/$defs/vintage"},
                "osm": {"$ref": "#/$defs/vintage"},
                "lidar": {"$ref": "#/$defs/vintage"},
                "buildings": {"$ref": "#/$defs/vintage"}
              }
            },
            "region": {"$ref": "#/$defs/slug"}
          },
          "additionalProperties": false,
          "patternProperties": {"^x_[a-z0-9_]+$(?!\\n)": {}}
        }
      }
    },
    "vintage": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$(?!\\n)"}
  }
}
