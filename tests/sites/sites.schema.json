{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sim-palms:schema:test-sites:1",
  "title": "sim-palms test-site registry",
  "description": "tests/sites/sites.yaml. Structural checks only; tests/helpers/sites.py adds range checks for sites with status: defined.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sites"],
  "properties": {
    "version": {"const": 1},
    "sites": {
      "type": "object",
      "propertyNames": {"pattern": "^T[0-9]+$"},
      "additionalProperties": {"$ref": "#/$defs/site"}
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "status", "purpose", "description", "region", "bbox", "photogrammetry",
        "inventory_coverage", "ground_truth", "flight", "time_local", "weather", "viewpoints"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["placeholder", "defined"]},
        "purpose": {"enum": ["happy_path", "lidar_only", "building_clip", "false_positive", "no_harm"]},
        "description": {"type": "string"},
        "region": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number"},
          "description": "lon_min, lat_min, lon_max, lat_max"
        },
        "photogrammetry": {"type": "boolean"},
        "inventory_coverage": {"type": "boolean"},
        "ground_truth": {"type": "boolean"},
        "flight": {"type": ["string", "null"], "minLength": 1},
        "time_local": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "weather": {"type": "string", "minLength": 1},
        "viewpoints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"$ref": "#/$defs/viewpoint_VP1"},
            {"$ref": "#/$defs/viewpoint_VP2"},
            {"$ref": "#/$defs/viewpoint_VP3"}
          ],
          "items": false
        }
      }
    },
    "viewpoint_common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "lat", "lon", "alt_m_agl", "heading_deg", "pitch_deg", "preset"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["street", "oblique", "approach"]},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "alt_m_agl": {"type": "number"},
        "heading_deg": {"type": "number"},
        "pitch_deg": {"type": "number"},
        "preset": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "viewpoint_VP1": {
      "allOf": [
        {"$ref": "#/$defs/viewpoint_common"},
        {"properties": {"id": {"const": "VP1"}, "kind": {"const": "street"}}}
      ]
    },
    "viewpoint_VP2": {
      "allOf": [
        {"$ref": "#/$defs/viewpoint_common"},
        {"properties": {"id": {"const": "VP2"}, "kind": {"const": "oblique"}}}
      ]
    },
    "viewpoint_VP3": {
      "allOf": [
        {"$ref": "#/$defs/viewpoint_common"},
        {"properties": {"id": {"const": "VP3"}, "kind": {"const": "approach"}}}
      ]
    }
  }
}
